#!/bin/sh

CYAN='\033[1;36m'
GREEN='\033[1;32m'
RED='\033[1;31m'
RESET='\033[0m'

printf "\n%b🔍 [1/2] Checking Dart code formatting...%b\n" "$CYAN" "$RESET"
dart format --output=none --set-exit-if-changed lib test || {
  printf "%b❌ Formatting issues detected. Files auto-formatted! Run 'git add .' and try again.%b\n" "$RED" "$RESET"
  exit 1
}
printf "  %b✅ Code formatting is clean!%b\n" "$GREEN" "$RESET"

printf "\n%b⚡ [2/2] Running Flutter static analyzer...%b\n" "$CYAN" "$RESET"
flutter analyze || {
  printf "%b❌ Flutter static analysis failed!%b\n" "$RED" "$RESET"
  exit 1
}
printf "  %b✅ Flutter analyzer passed cleanly!%b\n" "$GREEN" "$RESET"

printf "\n==================================================\n"
printf "%b🚀 All pre-commit checks passed successfully!%b\n" "$GREEN" "$RESET"
printf "==================================================\n\n"
